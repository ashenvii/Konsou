-- konsou.db, the user's own record. Sync copies it to Drive without the
-- names of linked entries and finished watches, the device row and the
-- settings that stay on one device.

CREATE TABLE entry (
  entry_id          TEXT NOT NULL PRIMARY KEY,
  name              TEXT,                    -- synced only while not linked
  status            TEXT NOT NULL CHECK (status IN (
                      'watching', 'completed', 'plan_to_watch', 'on_hold',
                      'dropped', 'rewatching', 'not_interested')),
  episodes_watched  INTEGER NOT NULL DEFAULT 0 CHECK (episodes_watched >= 0),
  score             INTEGER CHECK (score IS NULL OR (score >= 1 AND score <= 10)),
  notes             TEXT,
  plan_rank         INTEGER,
  added_at          INTEGER NOT NULL,
  started_at        INTEGER,
  -- sync merges each group on its own, the latest change wins; 0 is never changed
  progress_changed_at  INTEGER NOT NULL,   -- status, episodes, started date, plan rank
  score_changed_at     INTEGER NOT NULL DEFAULT 0,
  notes_changed_at     INTEGER NOT NULL DEFAULT 0,
  link_changed_at      INTEGER NOT NULL DEFAULT 0,  -- the provider references
  updated_at        INTEGER GENERATED ALWAYS AS (max(progress_changed_at,
                      score_changed_at, notes_changed_at, link_changed_at)) VIRTUAL
) AS Entry;

CREATE INDEX idx_entry_status ON entry (status);
CREATE INDEX idx_entry_updated ON entry (updated_at);

CREATE TABLE entry_reference (
  entry_id     TEXT NOT NULL REFERENCES entry (entry_id) ON DELETE CASCADE,
  provider     TEXT NOT NULL CHECK (provider IN ('mal', 'anilist')),
  provider_id  INTEGER NOT NULL,
  PRIMARY KEY (entry_id, provider)
) AS EntryReference;

-- not unique: anilist split three titles that mal keeps as one page
CREATE INDEX idx_reference_lookup ON entry_reference (provider, provider_id);

-- a suggested page the user said no to, never offered again for that entry
CREATE TABLE match_decline (
  entry_id     TEXT NOT NULL REFERENCES entry (entry_id) ON DELETE CASCADE,
  provider     TEXT NOT NULL CHECK (provider IN ('mal', 'anilist')),
  provider_id  INTEGER NOT NULL,
  declined_at  INTEGER NOT NULL,
  PRIMARY KEY (entry_id, provider, provider_id)
) AS MatchDecline;

-- no foreign key: a finished watch stays on record after its entry is removed
CREATE TABLE completion (
  entry_id             TEXT NOT NULL,
  watch_number         INTEGER NOT NULL,     -- 0 first watch, 1 first rewatch
  completed_at         INTEGER NOT NULL,
  episodes_watched     INTEGER NOT NULL DEFAULT 0,
  minutes_per_episode  INTEGER,              -- null: stats use 24
  is_estimated         BOOLEAN NOT NULL DEFAULT FALSE,
  name                 TEXT,                 -- local only, never synced
  PRIMARY KEY (entry_id, watch_number)
) AS Completion;

CREATE INDEX idx_completion_date ON completion (completed_at);

CREATE TABLE alert (
  entry_id             TEXT NOT NULL,
  related_provider     TEXT NOT NULL CHECK (related_provider IN ('mal', 'anilist')),
  related_provider_id  INTEGER NOT NULL,
  type                 TEXT NOT NULL CHECK (type IN (
                         'sequel', 'side_story', 'spin_off', 'movie', 'started_airing')),
  seen                 BOOLEAN NOT NULL DEFAULT FALSE,
  dismissed            BOOLEAN NOT NULL DEFAULT FALSE,
  created_at           INTEGER NOT NULL,
  PRIMARY KEY (entry_id, related_provider, related_provider_id, type)
) AS Alert;

-- an entry id sync folded into another, when two devices added the same title
CREATE TABLE entry_alias (
  alias_id  TEXT NOT NULL PRIMARY KEY,
  entry_id  TEXT NOT NULL
) AS EntryAlias;

CREATE TABLE deletion (
  entry_id    TEXT NOT NULL PRIMARY KEY,
  deleted_at  INTEGER NOT NULL
) AS Deletion;

CREATE TABLE setting (
  "key"       TEXT NOT NULL PRIMARY KEY,
  value       TEXT NOT NULL,
  updated_at  INTEGER NOT NULL DEFAULT 0
) AS Setting;

-- this device only, never synced
CREATE TABLE device (
  device_id       TEXT NOT NULL PRIMARY KEY,
  drive_version   TEXT,                       -- id and version of the drive file last seen
  drive_hash      TEXT,                       -- hash of the record as it is on drive
  newest_seen_at  INTEGER NOT NULL DEFAULT 0, -- newest change time seen in a merge
  last_synced_at  INTEGER
) AS Device;
