-- details.db, everything fetched from MAL or worked out from it. Never
-- synced, safe to delete, rebuilt on demand.

-- json is the only source; the other columns are read out of it by sqlite
CREATE TABLE detail (
  provider        TEXT NOT NULL,
  provider_id     INTEGER NOT NULL,
  fetched_at      INTEGER NOT NULL,
  json            TEXT NOT NULL,
  -- the trickle fetches a short field list; a detail page fetches all of them
  is_full         BOOLEAN NOT NULL DEFAULT FALSE,
  title           TEXT GENERATED ALWAYS AS (json_extract(json, '$.title')) VIRTUAL,
  title_english   TEXT GENERATED ALWAYS AS (
                    NULLIF(json_extract(json, '$.alternative_titles.en'), '')) VIRTUAL,
  title_japanese  TEXT GENERATED ALWAYS AS (
                    NULLIF(json_extract(json, '$.alternative_titles.ja'), '')) VIRTUAL,
  media_type      TEXT GENERATED ALWAYS AS (json_extract(json, '$.media_type')) VIRTUAL,
  airing_status   TEXT GENERATED ALWAYS AS (json_extract(json, '$.status')) VIRTUAL,
  -- mal sends 0 when the count is not known yet
  episodes        INTEGER GENERATED ALWAYS AS (
                    NULLIF(json_extract(json, '$.num_episodes'), 0)) VIRTUAL,
  start_date      TEXT GENERATED ALWAYS AS (json_extract(json, '$.start_date')) VIRTUAL,
  cover_url       TEXT GENERATED ALWAYS AS (COALESCE(
                    json_extract(json, '$.main_picture.large'),
                    json_extract(json, '$.main_picture.medium'))) VIRTUAL,
  nsfw            TEXT GENERATED ALWAYS AS (json_extract(json, '$.nsfw')) VIRTUAL,
  PRIMARY KEY (provider, provider_id)
) AS Detail;

-- entry_id points into konsou.db, a separate file, so there is no foreign key
CREATE TABLE franchise_link (
  entry_id               TEXT NOT NULL PRIMARY KEY,
  franchise_provider     TEXT NOT NULL,
  franchise_provider_id  INTEGER NOT NULL,
  is_extra               BOOLEAN NOT NULL DEFAULT FALSE,
  is_placeholder         BOOLEAN NOT NULL DEFAULT FALSE  -- true until the scan rebuilds it from mal
) AS FranchiseLink;

CREATE INDEX idx_franchise ON franchise_link (franchise_provider, franchise_provider_id);

-- a provider page that answered 404; checked again after a while in case it returns
CREATE TABLE gone_page (
  provider     TEXT NOT NULL,
  provider_id  INTEGER NOT NULL,
  checked_at   INTEGER NOT NULL,
  PRIMARY KEY (provider, provider_id)
) AS GonePage;

-- one row per franchise, keyed by the title it is named after
CREATE TABLE scan_schedule (
  provider       TEXT NOT NULL,
  provider_id    INTEGER NOT NULL,
  last_check_at  INTEGER NOT NULL,
  next_check_at  INTEGER NOT NULL,
  quiet_streak   INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (provider, provider_id)
) AS ScanSchedule;

CREATE INDEX idx_scan_due ON scan_schedule (next_check_at);

-- kept apart from detail: a search result has no related titles, and the
-- franchise scan would read it as a title with none
CREATE TABLE match_suggestion (
  entry_id     TEXT NOT NULL,
  provider     TEXT NOT NULL,
  provider_id  INTEGER NOT NULL,
  position     INTEGER NOT NULL,
  json         TEXT NOT NULL,
  found_at     INTEGER NOT NULL,
  PRIMARY KEY (entry_id, provider, provider_id)
) AS MatchSuggestion;

-- when Konsou last searched for a not-linked entry and could not link it
CREATE TABLE match_attempt (
  entry_id     TEXT NOT NULL PRIMARY KEY,
  searched_at  INTEGER NOT NULL
) AS MatchAttempt;

CREATE TABLE search_cache (
  query_hash  TEXT NOT NULL PRIMARY KEY,
  query_text  TEXT NOT NULL,
  results     TEXT NOT NULL,
  cached_at   INTEGER NOT NULL
) AS SearchCacheRow;
